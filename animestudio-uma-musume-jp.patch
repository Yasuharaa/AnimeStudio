+
+        public static FileReader DecryptUmaMusume(FileReader reader)
+        {
+            Logger.Verbose($"Attempting to decrypt file {reader.FileName} with Uma Musume encryption");
+
+            UmaMetaEntry entry;
+            try
+            {
+                entry = UmaMeta.FindByFile(reader.FullPath);
+            }
+            catch (Exception e)
+            {
+                Logger.Error($"[UmaMusume] Failed to load meta database for {reader.FileName}", e);
+                reader.Position = 0;
+                return reader;
+            }
+
+            if (entry == null || !entry.IsEncrypted)
+            {
+                Logger.Verbose(entry == null ? $"{reader.FileName} is not listed in meta, loading as is" : $"{entry.Name} is not encrypted");
+                reader.Position = 0;
+                return reader;
+            }
+
+            reader.Position = 0;
+            var data = reader.ReadBytes((int)reader.Remaining);
+            UmaCrypto.Apply(data, UmaCrypto.BuildKeystream(UmaKeys.Current.ABKeyBytes, entry.Key));
+
+            Logger.Verbose($"Decrypted Uma Musume file {entry.Name} successfully !!");
+
+            MemoryStream ms = new();
+            ms.Write(data);
+            ms.Position = 0;
+            reader.Dispose();
+            return new FileReader(reader.FullPath, ms);
+        }
     }
 }
