--- /dev/null
+++ b/AnimeStudio/UmaMusume/UmaCrypto.cs
@@ -0,0 +1,68 @@
+using System;
+
+namespace AnimeStudio
+{
+    /// <summary>
+    /// Uma Musume asset bundle encryption, reimplemented from the scheme UmaViewer uses
+    /// (UmaDatabaseEntry.FKey + UmaAssetBundleStream).
+    ///
+    /// keystream[i * 8 + j] = abKey[i] ^ fileKeyLE[j]     (length = abKey.Length * 8)
+    /// data[p] ^= keystream[p % keystream.Length]          for every absolute offset p >= 256
+    /// The first 256 bytes are stored in the clear, so the UnityFS header stays readable.
+    /// </summary>
+    public static class UmaCrypto
+    {
+        public const int HeaderSize = 256;
+        public const int DBBaseKeyLength = 13;
+
+        public static byte[] BuildKeystream(byte[] abKey, long fileKey)
+        {
+            if (abKey == null || abKey.Length == 0)
+            {
+                throw new ArgumentException("AB key is empty", nameof(abKey));
+            }
+
+            var keyBytes = BitConverter.GetBytes(fileKey);
+            if (!BitConverter.IsLittleEndian)
+            {
+                Array.Reverse(keyBytes);
+            }
+
+            var keystream = new byte[abKey.Length * 8];
+            for (int i = 0; i < abKey.Length; i++)
+            {
+                for (int j = 0; j < 8; j++)
+                {
+                    keystream[(i << 3) + j] = (byte)(abKey[i] ^ keyBytes[j]);
+                }
+            }
+            return keystream;
+        }
+
+        /// <summary> XOR is symmetric, so this both encrypts and decrypts. <paramref name="data"/> must start at file offset 0. </summary>
+        public static void Apply(byte[] data, byte[] keystream)
+        {
+            int len = keystream.Length;
+            for (int p = HeaderSize; p < data.Length; p++)
+            {
+                data[p] ^= keystream[p % len];
+            }
+        }
+
+        /// <summary> Final key for the encrypted meta database: dbKey[i] ^ baseKey[i % 13]. </summary>
+        public static byte[] FinalDbKey(byte[] dbKey, byte[] baseKey)
+        {
+            if (baseKey == null || baseKey.Length < DBBaseKeyLength)
+            {
+                throw new ArgumentException($"DB base key must be at least {DBBaseKeyLength} bytes", nameof(baseKey));
+            }
+
+            var key = (byte[])dbKey.Clone();
+            for (int i = 0; i < key.Length; i++)
+            {
+                key[i] ^= baseKey[i % DBBaseKeyLength];
+            }
+            return key;
+        }
+    }
+}
diff --git a/AnimeStudio/UmaMusume/UmaKeys.cs b/AnimeStudio/UmaMusume/UmaKeys.cs
new file mode 100644
index 0000000..9fbc422
--- /dev/null
+++ b/AnimeStudio/UmaMusume/UmaKeys.cs
@@ -0,0 +1,103 @@
+using System;
+using System.IO;
+using System.Text.Json;
+
+namespace AnimeStudio
+{
+    /// <summary>
+    /// Keys for Uma Musume (JP), loaded from UmaKeys.json next to the executable so they can be
+    /// updated without rebuilding. Missing or broken file -> defaults are written back.
+    /// Key values originate from UmaViewer (https://github.com/katboi01/UmaViewer).
+    /// </summary>
+    public sealed class UmaKeys
+    {
+        public const string FileName = "UmaKeys.json";
+
+        /// <summary> Base key for asset bundles (hex). </summary>
+        public string ABKey { get; set; }
+        /// <summary> Key for the JP "meta" database before it is combined with DBBaseKey (hex). </summary>
+        public string DBKey { get; set; }
+        /// <summary> Base key XORed into DBKey (hex, at least 13 bytes). </summary>
+        public string DBBaseKey { get; set; }
+
+        public static UmaKeys Defaults() => new UmaKeys
+        {
+            ABKey = "532B4631E4A7B9473E7CFB",
+            DBKey = "6D5B65336336632554712D73505363386D34377B356370233734532973433633",
+            DBBaseKey = "F170CEA4DFCEA3E1A5D8C70BD1",
+        };
+
+        private static readonly object Sync = new object();
+        private static UmaKeys current;
+
+        public static UmaKeys Current
+        {
+            get
+            {
+                lock (Sync)
+                {
+                    return current ??= Load();
+                }
+            }
+        }
+
+        /// <summary> Forces UmaKeys.json to be read again on next use. </summary>
+        public static void Reload()
+        {
+            lock (Sync)
+            {
+                current = null;
+            }
+        }
+
+        public byte[] ABKeyBytes => FromHex(ABKey, nameof(ABKey));
+        public byte[] DBKeyBytes => FromHex(DBKey, nameof(DBKey));
+        public byte[] DBBaseKeyBytes => FromHex(DBBaseKey, nameof(DBBaseKey));
+
+        private static string FilePath => Path.Combine(AppDomain.CurrentDomain.BaseDirectory, FileName);
+
+        private static UmaKeys Load()
+        {
+            try
+            {
+                var keys = JsonSerializer.Deserialize<UmaKeys>(File.ReadAllText(FilePath));
+                if (keys == null || string.IsNullOrWhiteSpace(keys.ABKey) || string.IsNullOrWhiteSpace(keys.DBKey) || string.IsNullOrWhiteSpace(keys.DBBaseKey))
+                {
+                    throw new InvalidDataException("missing key");
+                }
+                return keys;
+            }
+            catch (Exception)
+            {
+                Logger.Warning($"[UmaMusume] Could not read {FileName}, writing default keys.");
+                var keys = Defaults();
+                try
+                {
+                    File.WriteAllText(FilePath, JsonSerializer.Serialize(keys, new JsonSerializerOptions { WriteIndented = true }));
+                }
+                catch (Exception e)
+                {
+                    Logger.Warning($"[UmaMusume] Could not write {FileName}: {e.Message}");
+                }
+                return keys;
+            }
+        }
+
+        private static byte[] FromHex(string hex, string name)
+        {
+            hex = (hex ?? string.Empty).Replace(" ", string.Empty).Replace("-", string.Empty);
+            if (hex.StartsWith("0x", StringComparison.OrdinalIgnoreCase))
+            {
+                hex = hex.Substring(2);
+            }
+            try
+            {
+                return Convert.FromHexString(hex);
+            }
+            catch (FormatException)
+            {
+                throw new InvalidDataException($"[UmaMusume] {name} in {FileName} is not valid hex.");
+            }
+        }
+    }
+}
