+using System;
+using System.Collections.Generic;
+using System.Drawing;
+using System.IO;
+using System.Linq;
+using System.Threading.Tasks;
+using System.Windows.Forms;
+
+namespace AnimeStudio.GUI
+{
+    /// <summary>
+    /// Uma Musume (JP): load assets by their meta name (e.g. "3d/chara/body/bdy1001_00") together with
+    /// every dependency listed in the meta database, instead of picking hash-named files from dat/.
+    /// </summary>
+    partial class MainForm
+    {
+        private string umaGameFolder;
+        private string umaLastQuery = "3d/chara/body/bdy1001_00";
+
+        private void InitializeUmaMusume()
+        {
+            var item = new ToolStripMenuItem("Load Uma Musume asset...");
+            item.Click += loadUmaMusumeAsset_Click;
+            int index = fileToolStripMenuItem.DropDownItems.IndexOf(loadFolderToolStripMenuItem);
+            fileToolStripMenuItem.DropDownItems.Insert(index + 1, item);
+        }
+
+        private async void loadUmaMusumeAsset_Click(object sender, EventArgs e)
+        {
+            if (Studio.Game == null || !Studio.Game.Type.IsUmaMusume())
+            {
+                MessageBox.Show(this, "Select \"Uma Musume (JP)\" in the game selector first.", "Uma Musume", MessageBoxButtons.OK, MessageBoxIcon.Information);
+                return;
+            }
+
+            var root = UmaPickGameFolder();
+            if (root == null)
+            {
+                return;
+            }
+
+            var input = UmaPrompt(umaLastQuery);
+            if (string.IsNullOrWhiteSpace(input))
+            {
+                return;
+            }
+            umaLastQuery = input.Trim();
+
+            try
+            {
+                var paths = new List<string>();
+                var missing = new List<string>();
+                var query = umaLastQuery;
+                StatusStripUpdate("Reading Uma Musume meta...");
+                // The first call reads the whole meta database, keep it off the UI thread.
+                await Task.Run(() =>
+                {
+                    foreach (var prefix in query.Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
+                    {
+                        paths.AddRange(UmaMeta.ResolveFiles(root, prefix, out var missingForPrefix));
+                        missing.AddRange(missingForPrefix);
+                    }
+                });
+                paths = paths.Distinct(StringComparer.OrdinalIgnoreCase).ToList();
+                missing = missing.Distinct().ToList();
+                if (missing.Count > 0)
+                {
+                    Logger.Warning($"[UmaMusume] {missing.Count} entries are not downloaded and were skipped: {string.Join(", ", missing.Take(20))}{(missing.Count > 20 ? ", ..." : string.Empty)}");
+                }
+                if (paths.Count == 0)
+                {
+                    MessageBox.Show(this, $"No downloaded asset in meta starts with:\n{umaLastQuery}", "Uma Musume", MessageBoxButtons.OK, MessageBoxIcon.Warning);
+                    return;
+                }
+
+                Logger.Info($"[UmaMusume] Loading {paths.Count} files for \"{umaLastQuery}\" (assets + dependencies).");
+                openDirectoryBackup = Path.Combine(root, "dat");
+                LoadPaths(null, paths.ToArray());
+            }
+            catch (Exception ex)
+            {
+                Logger.Error("[UmaMusume] Failed to resolve assets", ex);
+                MessageBox.Show(this, ex.Message, "Uma Musume", MessageBoxButtons.OK, MessageBoxIcon.Error);
+            }
+        }
+
+        /// <summary> The folder holding "meta" and "dat". Asks once, defaulting to the DMM install location. </summary>
+        private string UmaPickGameFolder()
+        {
+            if (umaGameFolder != null && UmaMeta.FindRoot(umaGameFolder) == umaGameFolder)
+            {
+                return umaGameFolder;
+            }
+
+            var guess = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData) + "Low", "Cygames", "umamusume");
+            var dialog = new OpenFolderDialog
+            {
+                Title = "Select the Uma Musume data folder (contains \"meta\" and \"dat\")",
+                InitialFolder = Directory.Exists(guess) ? guess : openDirectoryBackup,
+            };
+            if (dialog.ShowDialog(this) != DialogResult.OK)
+            {
+                return null;
+            }
+
+            var root = UmaMeta.FindRoot(dialog.Folder);
+            if (root == null)
+            {
+                MessageBox.Show(this, "That folder (or its parents) has no \"meta\" file next to a \"dat\" folder.", "Uma Musume", MessageBoxButtons.OK, MessageBoxIcon.Warning);
+                return null;
+            }
+
+            umaGameFolder = root;
+            return root;
+        }
+
+        private string UmaPrompt(string initial)
+        {
+            using var form = new Form
+            {
+                Text = "Load Uma Musume asset",
+                FormBorderStyle = FormBorderStyle.FixedDialog,
+                StartPosition = FormStartPosition.CenterParent,
+                MinimizeBox = false,
+                MaximizeBox = false,
+                ClientSize = new Size(520, 150),
+            };
+            var label = new System.Windows.Forms.Label
+            {
+                Text = "Asset name or prefix from meta; separate several with ';'. Every match and all of its\n" +
+                       "dependencies are loaded together. Example: 3d/chara/body/bdy1001_00; 3d/chara/head/chr1001_00",
+                Location = new Point(12, 12),
+                Size = new Size(496, 48),
+            };
+            var input = new System.Windows.Forms.TextBox
+            {
+                Text = initial,
+                Location = new Point(12, 68),
+                Size = new Size(496, 27),
+            };
+            var ok = new System.Windows.Forms.Button { Text = "Load", DialogResult = DialogResult.OK, Location = new Point(352, 108), Size = new Size(75, 30) };
+            var cancel = new System.Windows.Forms.Button { Text = "Cancel", DialogResult = DialogResult.Cancel, Location = new Point(433, 108), Size = new Size(75, 30) };
+            form.Controls.AddRange(new Control[] { label, input, ok, cancel });
+            form.AcceptButton = ok;
+            form.CancelButton = cancel;
+
+            return form.ShowDialog(this) == DialogResult.OK ? input.Text : null;
+        }
+    }
+}
