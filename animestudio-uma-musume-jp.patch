+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+
+namespace AnimeStudio
+{
+    public sealed class UmaMetaEntry
+    {
+        /// <summary> Column m: asset category (e.g. "3d", "chara"). </summary>
+        public string Type;
+        /// <summary> Column n: logical asset name (e.g. "3d/chara/body/bdy1001_00/pfb_bdy1001_00"). </summary>
+        public string Name;
+        /// <summary> Column h: physical file name under dat/&lt;first 2 chars&gt;/. </summary>
+        public string Hash;
+        /// <summary> Column d: ';'-separated names this asset depends on. </summary>
+        public string Dependencies;
+        /// <summary> Column e: per-file key, 0 when the file is not encrypted. </summary>
+        public long Key;
+
+        public bool IsEncrypted => Key != 0;
+
+        public string GetFilePath(string root) => Path.Combine(root, "dat", Hash.Substring(0, 2), Hash);
+    }
+
+    /// <summary>
+    /// Index of Uma Musume's "meta" database (JP). The game folder is the one that holds both
+    /// the "meta" file and the "dat" folder; it is found by walking up from any loaded file.
+    /// </summary>
+    public static class UmaMeta
+    {
+        private static readonly object Sync = new object();
+        private static string loadedRoot;
+        private static Dictionary<string, UmaMetaEntry> byHash = new Dictionary<string, UmaMetaEntry>(StringComparer.OrdinalIgnoreCase);
+        private static Dictionary<string, UmaMetaEntry> byName = new Dictionary<string, UmaMetaEntry>(StringComparer.Ordinal);
+        private static readonly HashSet<string> warnedDirs = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+
+        public static string LoadedRoot
+        {
+            get { lock (Sync) return loadedRoot; }
+        }
+
+        /// <summary> Walks up from <paramref name="path"/> to the folder containing both "meta" and "dat". </summary>
+        public static string FindRoot(string path)
+        {
+            if (string.IsNullOrEmpty(path))
+            {
+                return null;
+            }
+
+            var dir = Directory.Exists(path) ? path : Path.GetDirectoryName(Path.GetFullPath(path));
+            while (!string.IsNullOrEmpty(dir))
+            {
+                if (File.Exists(Path.Combine(dir, "meta")) && Directory.Exists(Path.Combine(dir, "dat")))
+                {
+                    return dir;
+                }
+                dir = Path.GetDirectoryName(dir);
+            }
+            return null;
+        }
+
+        /// <summary> Meta entry for a physical file, loading the meta database of its game folder if needed. </summary>
+        public static UmaMetaEntry FindByFile(string fullPath)
+        {
+            var root = FindRoot(fullPath);
+            if (root == null)
+            {
+                var dir = Path.GetDirectoryName(Path.GetFullPath(fullPath)) ?? string.Empty;
+                lock (Sync)
+                {
+                    if (warnedDirs.Add(dir))
+                    {
+                        Logger.Warning($"[UmaMusume] No game folder (with \"meta\" and \"dat\") found above {dir}; files there are loaded without decryption.");
+                    }
+                }
+                return null;
+            }
+
+            lock (Sync)
+            {
+                EnsureLoadedLocked(root);
+                byHash.TryGetValue(Path.GetFileName(fullPath), out var entry);
+                return entry;
+            }
+        }
+
+        /// <summary> Loads (or reuses) the meta index of a game folder. </summary>
+        public static void EnsureLoaded(string root)
+        {
+            lock (Sync)
+            {
+                EnsureLoadedLocked(root);
+            }
+        }
+
+        /// <summary>
+        /// Physical files for every asset whose name starts with <paramref name="namePrefix"/>, plus all of
+        /// their dependencies (recursively). Files missing on disk (not downloaded) are reported in <paramref name="missing"/>.
+        /// </summary>
+        public static List<string> ResolveFiles(string root, string namePrefix, out List<string> missing)
+        {
+            var result = new List<string>();
+            missing = new List<string>();
+            namePrefix = (namePrefix ?? string.Empty).Trim().Replace('\\', '/');
+            if (namePrefix.Length == 0)
+            {
+                return result;
+            }
+
+            lock (Sync)
+            {
+                EnsureLoadedLocked(root);
+
+                var visited = new HashSet<string>(StringComparer.Ordinal);
+                var queue = new Queue<string>(byName.Keys.Where(n => n.StartsWith(namePrefix, StringComparison.Ordinal)).OrderBy(n => n, StringComparer.Ordinal));
+                while (queue.Count > 0)
+                {
+                    var name = queue.Dequeue();
+                    if (!visited.Add(name) || !byName.TryGetValue(name, out var entry))
+                    {
+                        continue;
+                    }
+
+                    var path = entry.GetFilePath(root);
+                    if (File.Exists(path))
+                    {
+                        result.Add(path);
+                    }
+                    else
+                    {
+                        missing.Add(name);
+                    }
+
+                    if (!string.IsNullOrEmpty(entry.Dependencies))
+                    {
+                        foreach (var dep in entry.Dependencies.Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
+                        {
+                            if (!visited.Contains(dep))
+                            {
+                                queue.Enqueue(dep);
+                            }
+                        }
+                    }
+                }
+            }
+            return result;
+        }
+
+        private static void EnsureLoadedLocked(string root)
+        {
+            root = Path.GetFullPath(root);
+            if (string.Equals(root, loadedRoot, StringComparison.OrdinalIgnoreCase))
+            {
+                return;
+            }
+
+            var entries = ReadMeta(Path.Combine(root, "meta"), UmaKeys.Current);
+
+            var newByHash = new Dictionary<string, UmaMetaEntry>(StringComparer.OrdinalIgnoreCase);
+            var newByName = new Dictionary<string, UmaMetaEntry>(StringComparer.Ordinal);
+            foreach (var e in entries)
+            {
+                newByHash.TryAdd(e.Hash, e);
+                newByName.TryAdd(e.Name, e);
+            }
+
+            byHash = newByHash;
+            byName = newByName;
+            loadedRoot = root;
+            Logger.Info($"[UmaMusume] Loaded meta from {root}: {entries.Count} entries, {entries.Count(x => x.IsEncrypted)} encrypted.");
+        }
+
+        /// <summary> Reads every row of table "a". Tries the file as plain SQLite first, then as ChaCha20-encrypted with the JP key. </summary>
+        public static List<UmaMetaEntry> ReadMeta(string metaPath, UmaKeys keys)
+        {
+            if (!File.Exists(metaPath))
+            {
+                throw new FileNotFoundException("[UmaMusume] meta database not found", metaPath);
+            }
+
+            Exception plainError;
+            try
+            {
+                return ReadMetaWithKey(metaPath, null);
+            }
+            catch (Exception e)
+            {
+                plainError = e;
+            }
+
+            Logger.Verbose($"[UmaMusume] meta is not plain SQLite ({plainError.Message}), trying encrypted.");
+            var finalKey = UmaCrypto.FinalDbKey(keys.DBKeyBytes, keys.DBBaseKeyBytes);
+            try
+            {
+                return ReadMetaWithKey(metaPath, finalKey);
+            }
+            catch (Exception e)
+            {
+                throw new InvalidDataException($"[UmaMusume] Could not open meta at {metaPath}. Check DBKey/DBBaseKey in {UmaKeys.FileName}. ({e.Message})", e);
+            }
+        }
+
+        private static List<UmaMetaEntry> ReadMetaWithKey(string metaPath, byte[] key)
+        {
+            var db = UmaSqlite3MC.OpenReadOnly(metaPath);
+            try
+            {
+                if (key != null)
+                {
+                    UmaSqlite3MC.SetKey(db, UmaSqlite3MC.CIPHER_CHACHA20, key);
+                }
+
+                bool hasKeyColumn = false;
+                UmaSqlite3MC.ForEachRow(db, "SELECT name FROM pragma_table_info('a') WHERE name = 'e'", _ => hasKeyColumn = true);
+
+                var sql = hasKeyColumn ? "SELECT m,n,h,d,e FROM a" : "SELECT m,n,h,d FROM a";
+                var list = new List<UmaMetaEntry>();
+                UmaSqlite3MC.ForEachRow(db, sql, stmt =>
+                {
+                    var name = UmaSqlite3MC.ColumnText(stmt, 1);
+                    var hash = UmaSqlite3MC.ColumnText(stmt, 2);
+                    if (string.IsNullOrEmpty(name) || string.IsNullOrEmpty(hash) || hash.Length < 2)
+                    {
+                        return;
+                    }
+
+                    list.Add(new UmaMetaEntry
+                    {
+                        Type = UmaSqlite3MC.ColumnText(stmt, 0),
+                        Name = name,
+                        Hash = hash,
+                        Dependencies = UmaSqlite3MC.ColumnText(stmt, 3),
+                        Key = hasKeyColumn ? UmaSqlite3MC.ColumnInt64(stmt, 4) : 0L,
+                    });
+                });
+                return list;
+            }
+            finally
+            {
+                UmaSqlite3MC.Close(db);
+            }
+        }
+    }
+}
